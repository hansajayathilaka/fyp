# Backend Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration - Add multiple origins separated by commas
CORS_ORIGINS=http://localhost:3000,http://192.168.8.100:3000,http://127.0.0.1:3000

# Session Configuration
SESSION_SECRET=your-secret-key-change-in-production

# Truvera API Configuration
TRUVERA_API_URL=https://api.truvera.io
TRUVERA_API_KEY=your-truvera-api-key

# Credential Configuration
ISSUER_DID=your-issuer-did
CREDENTIAL_SCHEMA_URL=https://schema.truvera.io/deip-access-credential