# Backend Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration - Add multiple origins separated by commas
CORS_ORIGINS=http://localhost:3000,http://192.168.8.100:3000,http://127.0.0.1:3000

# Session Configuration
SESSION_SECRET=your-secret-key-change-in-production

# Truvera API Configuration
TRUVERA_API_URL=https://api-testnet.truvera.io
TRUVERA_API_KEY=xxxxxxxx

# Credential Configuration
ISSUER_DID=did:cheqd:testnet:xxxxx
CREDENTIAL_SCHEMA_URL=https://schema.truvera.io/DEIPAccessCredential-V1-1753929478754.json


# Frontend Environment Variables

# API Configuration - Update this with your machine's IP address
VITE_API_URL=http://192.168.8.100:3001

# Development Configuration
VITE_NODE_ENV=development
