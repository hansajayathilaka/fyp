# Server Configuration
PORT=4001
NODE_ENV=development

# Truvera API Configuration
TRUVERA_API_URL=https://api-testnet.truvera.io
TRUVERA_API_KEY=your_truvera_api_key_here

# CORS Configuration
FRONTEND_URL=http://localhost:4000

# Blockchain Integration
BLOCKCHAIN_ENABLED=true
ACCOUNT_PRIVATE_KEY=your_private_key_here
# Note: Contract address and RPC URL are automatically read from deployment-info.json
# The deployment-info.json file contains the deployed contract addresses and network configuration