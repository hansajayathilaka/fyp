# Server Configuration
PORT=4001
NODE_ENV=development

# Truvera API Configuration
TRUVERA_API_URL=https://api-testnet.truvera.io
TRUVERA_API_KEY=your_truvera_api_key_here

# CORS Configuration
FRONTEND_URL=http://localhost:4000

# Blockchain Integration
BLOCKCHAIN_ENABLED=true
SMART_CONTRACT_ADDRESS=your_contract_address_here
ACCOUNT_PRIVATE_KEY=your_private_key_here
BLOCKCHAIN_RPC_URL=your_rpc_url_here