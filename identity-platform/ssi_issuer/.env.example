# SSI Issuing Platform Environment Configuration
# Copy this file to .env and update the values for your environment

# Domain Configuration
DOMAIN=example.com

# Traefik Configuration
TRAEFIK_EMAIL=admin@example.com

# Application Configuration
NODE_ENV=production
JWT_SECRET=your-super-secure-jwt-secret-change-this-in-production

# KERIA Configuration
KERIA_IMAGE=weboftrust/keria:1.2.0-dev4

# MongoDB Configuration (for production)
MONGODB_URI=mongodb://admin:your-secure-password@mongodb:27017/ssi_issuer?authSource=admin
MONGODB_ROOT_USERNAME=admin
MONGODB_ROOT_PASSWORD=your-secure-password

# CORS Configuration (for production)
CORS_ORIGINS=https://ssi-issuer.example.com,https://ssi-issuer-admin.example.com