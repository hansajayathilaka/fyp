# SSI Issuer Platform Environment Configuration

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://admin:your-password@mongodb:27017/ssi_issuer?authSource=admin
MONGODB_ROOT_USERNAME=admin
MONGODB_ROOT_PASSWORD=your-secure-password

# KERIA Configuration
KERIA_URL=http://keria:3901
KERIA_BOOT_URL=http://keria:3903

# Authentication
JWT_SECRET=your-jwt-secret-here
SESSION_TIMEOUT=3600

# Traefik Configuration (Production)
DOMAIN=yourdomain.com
TRAEFIK_EMAIL=admin@yourdomain.com

# SSL Configuration
SSL_ENABLED=true
HTTPS_REDIRECT=true