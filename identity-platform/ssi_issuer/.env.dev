# SSI Issuing Platform Development Environment Configuration
# Development environment settings

# Domain Configuration (not used in dev mode)
DOMAIN=localhost

# Application Configuration
NODE_ENV=development
JWT_SECRET=dev-jwt-secret-change-in-production

# KERIA Configuration
KERIA_IMAGE=weboftrust/keria:1.2.0-dev4

# MongoDB Configuration (for development)
MONGODB_URI=mongodb://admin:dev-password@mongodb-dev:27017/ssi_issuer_dev?authSource=admin
MONGODB_ROOT_USERNAME=admin
MONGODB_ROOT_PASSWORD=dev-password

# CORS Configuration (for development)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://ssi-issuer.localhost,http://ssi-issuer-admin.localhost

# Development Ports
API_PORT=3000
ADMIN_PORT=3001
PUBLIC_PORT=3002
KERIA_ADMIN_PORT=3901
KERIA_BOOT_PORT=3903