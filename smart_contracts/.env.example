# Private key for deploying to Sonic testnet
# Replace with your actual private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Sonic testnet RPC URL (default is provided in hardhat.config.ts)
SONIC_RPC_URL=https://rpc.blaze.soniclabs.com

# Sonic block explorer API key for contract verification
SONICSCAN_API_KEY=your_sonicscan_api_key_here

# Network configuration
# Default network to use (hardhat, sonic)
DEFAULT_NETWORK=hardhat