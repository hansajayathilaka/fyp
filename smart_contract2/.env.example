# Private key for deploying to Hedera testnet
# Replace with your actual private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Optional: Hedera testnet RPC URL (default is provided in hardhat.config.ts)
# HEDERA_TESTNET_URL=https://testnet.hashio.io/api

# Optional: Etherscan API key for contract verification
# ETHERSCAN_API_KEY=your_etherscan_api_key_here