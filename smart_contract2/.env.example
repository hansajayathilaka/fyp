# Private key for deploying to Hedera testnet
# Replace with your actual private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Optional: Hedera testnet RPC URL (default is provided in hardhat.config.ts)
# HEDERA_TESTNET_URL=https://testnet.hashio.io/api/v1

# Optional: Etherscan API key for contract verification
# ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Decimal handling system configuration
# Default network to use (hardhat, ethereum, hedera-testnet, hedera-mainnet)
DEFAULT_NETWORK=hardhat

# Custom RPC URLs for networks
# ETHEREUM_MAINNET_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
# HEDERA_TESTNET_URL=https://testnet.hashio.io/api

# Fallback decimal places (0-18, default: 18)
# FALLBACK_DECIMALS=18