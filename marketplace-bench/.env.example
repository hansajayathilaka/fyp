# Shared signer for all networks below. Fund this address on each network you deploy to.
PRIVATE_KEY=

# Track A linear-chain testnet (Ethereum-family). Sepolia recommended.
SEPOLIA_RPC_URL=

# Track A DAG-chain testnet. Placeholder — fill in once §2.1 is decided.
# Hedera: JSON-RPC relay URL (e.g. https://testnet.hashio.io/api), DAG_CHAIN_ID=296
# Conflux eSpace: RPC URL (e.g. https://evmtestnet.confluxrpc.com), DAG_CHAIN_ID=71
DAG_CHAIN_RPC_URL=
DAG_CHAIN_ID=

# Optional: used by bench.ts / analysis scripts to convert native token amounts to a
# common USD basis at execution time instead of a static rate.
COINGECKO_API_KEY=
