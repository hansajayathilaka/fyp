{
  "name": "marketplace-bench",
  "version": "1.0.0",
  "description": "DAG-based vs. linear blockchain evaluation — shared Solidity marketplace codebase and benchmark harness",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.ts --network hardhat",
    "seed:local": "hardhat run scripts/seed.ts --network hardhat",
    "bench:local": "hardhat run scripts/bench.ts --network hardhat",
    "compare:up": "docker compose -f docker/local/docker-compose.yml up -d",
    "compare:down": "docker compose -f docker/local/docker-compose.yml down",
    "compare:fund-conflux": "ts-node scripts/fund-conflux-espace.ts",
    "node": "hardhat node",
    "clean": "hardhat clean"
  },
  "keywords": [
    "blockchain",
    "dag",
    "hedera",
    "conflux",
    "benchmark",
    "hardhat"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.0",
    "js-conflux-sdk": "^2.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
