# ==============================================
# DOCKER REGISTRY CONFIGURATION
# ==============================================
REGISTRY=asia-southeast1-docker.pkg.dev/fyp-deip/fyp-registry
TAG=latest

# ==============================================
# GCP CLOUD RUN CONFIGURATION
# ==============================================
GCP_PROJECT_ID=fyp-deip
GCP_REGION=asia-southeast1

# ==============================================
# GENERAL CONFIGURATION
# ==============================================
NODE_ENV=production

# ==============================================
# PORT CONFIGURATION
# ==============================================
ISSUER_BACKEND_PORT=3001
ISSUER_FRONTEND_PORT=3000
VERIFIER_BACKEND_PORT=4001
VERIFIER_FRONTEND_PORT=4000
SMART_CONTRACTS_UI_PORT=3002

# ==============================================
# TRUVERA API CONFIGURATION (SHARED)
# ==============================================
TRUVERA_API_URL=https://api-testnet.truvera.io
TRUVERA_API_KEY=your-truvera-api-key-here

# ==============================================
# ISSUER SERVICE CONFIGURATION
# ==============================================

# Issuer Backend Configuration
ISSUER_SESSION_SECRET=your-secure-session-secret-change-in-production
ISSUER_DID=did:cheqd:testnet:your-issuer-did-here
CREDENTIAL_SCHEMA_URL=https://schema.truvera.io/DEIPAccessCredential-V1-1753929478754.json

# Issuer CORS Origins (comma-separated)
ISSUER_CORS_ORIGINS=http://localhost:3000,http://issuer-frontend:80

# Issuer Frontend API URL
ISSUER_FRONTEND_API_URL=http://localhost:3001

# ==============================================
# VERIFIER SERVICE CONFIGURATION
# ==============================================

# Verifier Frontend URL
VERIFIER_FRONTEND_URL=http://localhost:4000

# Verifier Frontend API URL
VERIFIER_FRONTEND_API_URL=http://localhost:4001

# Blockchain Configuration
BLOCKCHAIN_ENABLED=true
SMART_CONTRACT_ADDRESS=your-smart-contract-address-here
BLOCKCHAIN_RPC_URL=your-blockchain-rpc-url-here

# Verifier Frontend Configuration
VITE_CUSTOM_INTEGRATION_ENABLED=false
VITE_DEFAULT_TIMEOUT_MINUTES=15

# ==============================================
# SMART CONTRACTS CONFIGURATION
# ==============================================

# Default network to use (hardhat, ethereum, hedera-testnet, hedera-mainnet)
DEFAULT_NETWORK=hardhat

# Fallback decimal places (0-18, default: 18)
FALLBACK_DECIMALS=18

# SSI Sign-in URL for the smart contracts UI
NEXT_PUBLIC_SSI_SIGNIN_URL=http://localhost:3000

# ==============================================
# SENSITIVE CONFIGURATION (PRIVATE KEYS)
# ==============================================
# These should be set as environment variables or in a secure .env file
# DO NOT commit these values to version control

# Blockchain Private Key (for verifier backend and smart contracts)
ACCOUNT_PRIVATE_KEY=your-private-key-here

# ==============================================
# DEVELOPMENT OVERRIDES
# ==============================================
# Uncomment and modify these for development

# Development API URLs (if running services on different ports)
# ISSUER_FRONTEND_API_URL=http://host.docker.internal:3001
# VERIFIER_FRONTEND_API_URL=http://host.docker.internal:4001

# Development CORS (if accessing from host machine)
# ISSUER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://host.docker.internal:3000

# Custom RPC URLs for networks
# ETHEREUM_MAINNET_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
# HEDERA_TESTNET_URL=https://testnet.hashio.io/api